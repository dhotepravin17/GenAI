{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/GenAI/GenAI.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      // Starts the Vite dev server and stays running.
      // NOTE: uses the Node install directly because "npm" on PATH resolves through
      // an nvm symlink into another user's profile and fails with EPERM.
      // Once the system PATH is fixed, this can simply be "npm".
      "label": "start-client",
      "type": "process",
      "command": "C:/Program Files/nodejs/npm.cmd",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/client" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*(ready in|Local:).*"
        }
      },
      "presentation": { "group": "genai", "panel": "dedicated" }
    }
  ]
}
