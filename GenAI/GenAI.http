@GenAI_HostAddress = http://localhost:5217

# Start a new conversation with the agent
POST {{GenAI_HostAddress}}/api/agent/chat
Content-Type: application/json

{
  "message": "Hello! What can you help me with?"
}

###

# Continue an existing conversation (replace with the conversationId from the previous response)
POST {{GenAI_HostAddress}}/api/agent/chat
Content-Type: application/json

{
  "message": "Summarize what we discussed so far.",
  "conversationId": "REPLACE-WITH-CONVERSATION-ID"
}

###

# End a conversation and delete its history
DELETE {{GenAI_HostAddress}}/api/agent/conversations/REPLACE-WITH-CONVERSATION-ID

###

# Tool call: weather
POST {{GenAI_HostAddress}}/api/agent/chat
Content-Type: application/json

{
  "message": "What is the current weather in Doha?"
}

###

# Tool call: currency conversion
POST {{GenAI_HostAddress}}/api/agent/chat
Content-Type: application/json

{
  "message": "Convert 1000 QAR to INR"
}

###

# Both tools in a single turn
POST {{GenAI_HostAddress}}/api/agent/chat
Content-Type: application/json

{
  "message": "What is the weather in Pune, and how much is 50 EUR in QAR?"
}

###

# ---------- Conversation context (stored in API memory) ----------

# Save context (replaces anything stored)
PUT {{GenAI_HostAddress}}/api/agent/conversations/my-conversation/context
Content-Type: application/json

{
  "context": "The user is Pravin, a .NET developer based in Doha, Qatar."
}

###

# Append to the stored context
POST {{GenAI_HostAddress}}/api/agent/conversations/my-conversation/context
Content-Type: application/json

{
  "context": "He prefers short answers."
}

###

# Read the stored context
GET {{GenAI_HostAddress}}/api/agent/conversations/my-conversation/context
Accept: application/json

###

# Chat using the stored context
POST {{GenAI_HostAddress}}/api/agent/chat
Content-Type: application/json

{
  "message": "What is the weather where I live?",
  "conversationId": "my-conversation"
}

###

# Clear the stored context
DELETE {{GenAI_HostAddress}}/api/agent/conversations/my-conversation/context

###
